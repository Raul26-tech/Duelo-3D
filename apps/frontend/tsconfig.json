{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "erasableSyntaxOnly": true,
        "types": ["node"]
    },
    "include": ["src", "tests", "vite.config.ts"]
}
