{
    "name": "frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": "^24.15.0"
    },
    "scripts": {
        "dev": "npm run build:admin && vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build && npm run build:admin",
        "preview": "vite preview --host 127.0.0.1",
        "test": "node --test tests/*.test.ts",
        "check:media": "node --test tests/media.test.ts",
        "build:admin": "vite build --config vite.admin.config.ts",
        "build:homologation": "vite build --config vite.homologation.config.ts && npm run build:admin"
    },
    "devDependencies": {
        "@types/jsdom": "30.0.0",
        "@types/node": "26.6.5",
        "jsdom": "30.1.3",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    }
}
