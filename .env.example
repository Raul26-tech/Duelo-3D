# Configuração local opcional do monorepo. Copie para .env na raiz.
FRONTEND_PORT=5173
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1

# O entrypoint dev habilita simulação local; false desabilita explicitamente.
SIMULATION_MODE=true
# Opcional: chave privada de 32 a 128 caracteres [A-Za-z0-9_-].
# Sem chave, o backend dev gera uma temporária e mostra somente no terminal.
# SIMULATION_TOKEN=

# Diagnóstico TikTok: processo separado, somente observação e desligado por padrão.
TIKTOK_DIAGNOSTIC_ENABLED=false
# Handle público sem @ ou URL; obrigatório somente quando o diagnóstico estiver ativo.
# TIKTOK_USERNAME=nome_da_conta
# Opcional: chave privada do serviço de assinatura, nunca prefixar com VITE_.
# TIKTOK_SIGN_API_KEY=
