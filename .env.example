# Configuração local opcional do monorepo. Copie para .env na raiz.
FRONTEND_PORT=5173
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1

# O entrypoint dev habilita simulação local; false desabilita explicitamente.
SIMULATION_MODE=true
# Opcional: chave privada de 32 a 128 caracteres [A-Za-z0-9_-].
# Sem chave, o backend dev gera uma temporária e mostra somente no terminal.
# SIMULATION_TOKEN=

# Diagnóstico TikTok: processo separado, somente observação e desligado por padrão.
TIKTOK_DIAGNOSTIC_ENABLED=false
# Handle público sem @ ou URL; obrigatório somente quando o diagnóstico estiver ativo.
# TIKTOK_USERNAME=nome_da_conta
# Opcional: chave privada do serviço de assinatura, nunca prefixar com VITE_.
# TIKTOK_SIGN_API_KEY=

# Modos mutuamente exclusivos. O padrão continua sendo simulação local.
DUEL_MODE=simulation
TIKTOK_REAL_ENABLED=false
# Confirmar identidade de ocorrência do conector fixado antes de habilitar real.
TIKTOK_IDENTITY_REVIEWED=false
# Obrigatórios no modo real: sala revisada, caminho absoluto fora do projeto,
# e ação explícita. Use create somente com arquivo novo; depois use resume.
# TIKTOK_ROOM_ID=
# TIKTOK_DATABASE=/home/operador/.local/state/duelo-3d/disputa.sqlite
# TIKTOK_SESSION_ACTION=resume
# Opcional: JSON do catálogo revisado pelo operador. Ausente = nenhum presente.
# TIKTOK_GIFT_CATALOG=/home/operador/.config/duelo-3d/gifts.json

# Somente diagnose:tiktok: relatório agregado opcional, arquivo NOVO fora do projeto.
# Não autoriza presentes e não inclui IDs de usuários ou texto de comentários.
# TIKTOK_GIFT_REPORT=/home/operador/.local/state/duelo-3d/gifts-observed.json
